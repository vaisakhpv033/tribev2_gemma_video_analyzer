# =============================================================================
# Production Environment Configuration Template — Video Creative Analyzer
# =============================================================================
# Copy this file to `.env` on your production server:
# `cp .env.production .env`
# Fill in your secure secrets, credentials, and API keys.
# =============================================================================

# Django core settings  
DEBUG=False
DJANGO_SECRET=your_production_secure_random_secret_key_here

# Hosts that are allowed to make requests to this API (comma-separated).
# Include your frontend domain and your API subdomain (e.g. `api.yourdomain.com`).
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

# The external port Gunicorn will bind to on the host OS
BACKEND_PORT=8020

# Database Settings
# Note: DB_HOST must point to 'db' (the docker container name), not 127.0.0.1
DB_ENGINE=django.db.backends.postgresql
DB_NAME=video_creative_analyzer
DB_USER=vca_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# Celery and Redis Settings
# Note: Host must point to 'redis' (the docker container name)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# RunPod GPU Lifecyle Manager Configuration
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_TEMPLATE_ID=your_runpod_template_id_here
RUNPOD_GPU_TYPES=NVIDIA RTX A5000,NVIDIA A40
RUNPOD_IDLE_TIMEOUT_SECONDS=120
